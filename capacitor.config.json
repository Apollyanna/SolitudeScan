{
  "appId": "com.solitudescan.app",
  "appName": "SolitudeScan",
  "webDir": "www",
  "server": {
    "androidScheme": "https",
    "allowNavigation": [
      "solitudescan.com",
      "*.solitudescan.com",
      "*.supabase.co"
    ]
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#0c070f",
      "showSpinner": false,
      "androidSplashResourceName": "splash",
      "splashFullScreen": true,
      "splashImmersive": true
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0c070f"
    }
  },
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#0c070f",
    "webContentsDebuggingEnabled": false
  }
}
